      <column caption='Pdays group' datatype='string' name='[Calculation_0161655695294465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [V14] = -1 THEN &quot;Never Contacted&quot;&#13;&#10;ELSEIF [V14] &lt;= 90 THEN &quot;1-90 Days&quot;&#13;&#10;ELSEIF [V14] &lt;= 180 THEN &quot;91-180 Days&quot;&#13;&#10;ELSEIF [V14] &lt;= 365 THEN &quot;181-365 Days&quot;&#13;&#10;ELSE &quot;365+ Days&quot;&#13;&#10;END' />
      </column>
      <column caption='Previous_Outcome _Success' datatype='real' name='[Calculation_0576447128940544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([V16] = &quot;success&quot;, 1, 0)) / COUNT([V16])' />
      </column>
      <column caption='Avg_pday_recontacted' datatype='real' name='[Calculation_0576447131176961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;IF [V14] &gt;0 &#13;&#10;THEN [V14]&#13;&#10;END)' />
      </column>
      <column caption='Customers Recontacted %' datatype='integer' name='[Calculation_0576447131852802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF[V15]&gt;0 THEN 1 else 0 END&#13;&#10;)' />
      </column>
      <column caption='Avg Contacts - Subscribers' datatype='integer' name='[Calculation_0576447136489476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1392009561391104] = &quot;Yes&quot; THEN [V13] END' />
      </column>
      <column caption='Avg Contacts - Non_Subscribers' datatype='integer' name='[Calculation_0576447136567301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1392009561391104] = &quot;No&quot; THEN [V13] END' />
      </column>
      <column caption='Campaign Intensity' datatype='string' name='[Calculation_1172655207845888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [V13] &lt;= 2 THEN &quot;Low&quot;&#13;&#10;ELSEIF [V13] &lt;= 5 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Previous Contact Status' datatype='string' name='[Calculation_1172655210287105]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [V15] &gt; 0 THEN &quot;Previously Contacted&quot;&#13;&#10;ELSE &quot;First-Time Contact&quot;&#13;&#10;END' />
      </column>
      <column caption='Housing Loan Customers' datatype='integer' name='[Calculation_1172655217881090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [V7] = &quot;yes&quot; &#13;&#10;THEN 1 &#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Personal Loan Customers' datatype='integer' name='[Calculation_1172655218274307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [V8] = &quot;yes&quot;&#13;&#10;THEN 1 &#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Subscription_flag' datatype='integer' name='[Calculation_1324386253320193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Class] = 2 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Subscription Rate' datatype='real' name='[Calculation_1324386255863811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1324386253320193]) / COUNT([Calculation_1324386253320193])' />
      </column>
      <column caption='Subscribed Label' datatype='string' name='[Calculation_1392009561391104]' role='dimension' type='nominal'>
